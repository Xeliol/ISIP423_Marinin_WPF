<Page x:Class="WpfApp1.Pages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AccountPage">

    <Grid Background="FloralWhite">
        <TextBlock Height="30" VerticalAlignment="Top" Background="MediumPurple"></TextBlock>
        <TextBlock FontSize="24" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White">Account</TextBlock>
        <StackPanel Margin="0 40" Orientation="Horizontal">
            <StackPanel x:Name="MoviePanel" Width="360" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Login, StringFormat=Name: {0}}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Phone, StringFormat=Phone: {0}}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Email, StringFormat=Email: {0}}" HorizontalAlignment="Center"/>
                <Button x:Name="LogOutButton"  Width="100" BorderBrush="White" BorderThickness="2" Background="MediumPurple" Foreground="White" Click="LogOutButton_Click">Log Out</Button>
            </StackPanel>
            <StackPanel Width="400" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <TextBlock Text="Tickets" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"/>
                <ListBox x:Name="SessionListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0 30 0 0" Background="FloralWhite">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Height="100" Width="400">
                                <TextBlock FontSize="18" FontWeight="Bold" Text="Ticket" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Session.TheaterID, StringFormat=Theater №{0}}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Seat, StringFormat=Seat: №{0}}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Session.Theaters.Rating, StringFormat=Rating: {0}}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Session.Time, StringFormat={}{0:dd MMMM, hh:mm tt}}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
